!.yarn/plugins
!.yarn/releases
!.yarn/versions

# hasil build
/.next/
/out/
/build
/dist

# env & rahasia
.env
.env.*
!.env.example

# log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# tes & liputan
/coverage

# cache alat
.turbo/
.cache/
